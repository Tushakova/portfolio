index 0000000..42535fd
--- /dev/null
+++ b/src/events/auto_discovery.py
@@ -0,0 +1,176 @@
+"""Conservative unattended discovery. Only direct, verified listings qualify."""
+
+from collections import Counter
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime
+import json
+from pathlib import Path
+import re
+from urllib.parse import urljoin, urlsplit
+
+from src.events.candidates import (
+    LONDON, MAX_EVENTS_PER_PAGE, canonical_url, public_url, verify_event,
+)
+from src.events.http import FetchError, fetch_html
+from src.events.models import Event
+from src.events.source_policy import source_kind
+from src.events.structured_data import extract_schema_events
+
+REGISTRY = Path("data/auto-discovered-events.json")
+MAX_SEARCH_PAGES = 24
+MAX_ACTIVE = 20
+MAX_NEW_PER_RUN = 5
+RESTRICTED_AUDIENCE = re.compile(
+    r"\b(?:employees?|staff|members?|students?|graduates?|alumni|partners?|customers?)\s+only\b"
+    r"|\b(?:by invitation|private event|internal event|closed to the public)\b", re.I,
+)
+
+
+def detail_page(url: str) -> bool:
+    if not public_url(url) or urlsplit(url).scheme != "https":
+        return False
+    page = urlsplit(url)
+    host = (page.hostname or "").removeprefix("www.")
+    path = page.path.rstrip("/")
+    # Registration links to existing Meetup groups belong to the daily collector.
+    if host in {"eventbrite.com", "eventbrite.co.uk"}:
+        return bool(re.fullmatch(r"/e/[^/]+-tickets-\d+", path))
+    if host in {"luma.com", "lu.ma"}:
+        return bool(re.fullmatch(r"/[a-z0-9-]{5,}", path, re.I))
+    if host == "tickettailor.com":
+        return bool(re.fullmatch(r"/events/[^/]+/\d+", path))
+    return source_kind(url) == "organiser" and len(path.strip("/").split("/")) >= 2
+
+
+def same_listing(first: str, second: str) -> bool:
+    return canonical_url(first) == canonical_url(second)
+
+
+def has_booking_evidence(item: dict, url: str) -> bool:
+    offers = item.get("offers", [])
+    if not isinstance(offers, list):
+        offers = [offers]
+    for offer in offers:
+        if not isinstance(offer, dict) or not isinstance(offer.get("url"), str):
+            continue
+        booking = urljoin(url, offer["url"])
+        status = str(offer.get("availability", "")).split("/")[-1]
+        if (status in {"InStock", "LimitedAvailability"} and detail_page(booking)
+                and (same_listing(booking, url)
+                     or (source_kind(url) == "organiser" and source_kind(booking) == "platform"))):
+            return True
+    return False
+
+
+def has_uk_venue(item: dict) -> bool:
+    locations = item.get("location", [])
+    if not isinstance(locations, list):
+        locations = [locations]
+    for location in locations:
+        address = location.get("address") if isinstance(location, dict) else None
+        if not isinstance(address, dict):
+            continue
+        locality = str(address.get("addressLocality", "")).strip().casefold()
+        country = address.get("addressCountry", "")
+        if isinstance(country, dict):
+            country = country.get("name") or country.get("identifier", "")
+        if locality in {"london", "greater london"} and str(country).strip().casefold() in {
+            "gb", "gbr", "uk", "united kingdom", "great britain", "england",
+        }:
+            return True
+    return False
+
+
+def verify_page(url: str, now: datetime, *, require_future: bool = True) -> tuple[Event | None, str]:
+    if not detail_page(url):
+        return None, "unsupported listing"
+    try:
+        html = fetch_html(url, timeout=8, attempts=1, max_bytes=2_000_000, allow_redirects=False)
+        structured = extract_schema_events(html)
+        if len(structured) > MAX_EVENTS_PER_PAGE:
+            return None, "too many records"
+        matches = []
+        for item in structured:
+            raw_url = item.get("url")
+            if not isinstance(raw_url, str) or not same_listing(urljoin(url, raw_url), url):
+                continue
+            state = str(item.get("eventStatus", "")).split("/")[-1]
+            if state not in ("", "EventScheduled") or RESTRICTED_AUDIENCE.search(
+                f"{item.get('name', '')} {item.get('description', '')}"
+            ):
+                continue
+            event, _, _ = verify_event(item, url, now)
+            if (event and event.topics and event.format in {"in_person", "hybrid"}
+                    and event.venue_name and not event.time_tbc
+                    and (not require_future or datetime.fromisoformat(event.start_at) > now)
+                    and has_uk_venue(item) and has_booking_evidence(item, url)):
+                matches.append(event)
+        if len(matches) == 1:
+            return matches[0], "verified"
+        return None, "missing or ambiguous event evidence"
+    except (FetchError, ValueError, TypeError, UnicodeError, OSError, LookupError):
+        return None, "page unavailable or invalid"
+
+
+def identity(item: dict) -> set[tuple[str, ...]]:
+    title = " ".join(re.findall(r"\w+", item["title"].casefold()))
+    local_day = datetime.fromisoformat(item["start_at"]).astimezone(LONDON).date().isoformat()
+    url = canonical_url(item["source_url"])
+    p = urlsplit(url)
+    keys = {("id", item["id"]), ("url-day", url, local_day), ("title-day", title, local_day)}
+    # Booking page IDs stay stable even when marketing slugs or tracking change.
+    if detail_page(url):
+        keys.add(("listing", p.netloc, p.path))
+        if p.netloc in {"eventbrite.com", "eventbrite.co.uk"}:
+            keys.add(("eventbrite", p.path.rsplit("-", 1)[-1]))
+    return keys
+
+
+def collect(base: list[Event], previous: dict, now: datetime, *, discover_new: bool
+            ) -> tuple[list[Event], list[dict] | None]:
+    from src.events.build import is_past
+
+    history = json.loads(REGISTRY.read_text(encoding="utf-8"))["events"] if REGISTRY.exists() else []
+    current_keys = {k for event in base for k in identity(event.to_dict())}
+    known = previous.get("events", []) + previous.get("past_events", [])
+    seen = current_keys | {k for item in known + history for k in identity(item)}
+    # The bounded change log also remembers IDs for records removed from their sources.
+    seen.update(("id", row["event_id"]) for row in previous.get("changes", []))
+    active = [r for r in history if not is_past(r, now)][:MAX_ACTIVE]
+    verified = []
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        checks = pool.map(lambda r: verify_page(r["source_url"], now, require_future=False), active)
+        for old, (event, _) in zip(active, checks):
+            if event and event.id == old["id"] and not identity(event.to_dict()) & current_keys:
+                verified.append(event)
+                current_keys.update(identity(event.to_dict()))
+        if not discover_new or len(active) >= MAX_ACTIVE:
+            return verified, None
+        from src.events.search import discover
+
+        urls, search = discover()
+        pages = sorted({url for url in urls if detail_page(url)})[:MAX_SEARCH_PAGES]
+        reasons: Counter[str] = Counter()
+        added = []
+        capacity = min(MAX_NEW_PER_RUN, MAX_ACTIVE - len(active))
+        for event, reason in pool.map(lambda url: verify_page(url, now), pages):
+            if event is None:
+                reasons[reason] += 1
+            else:
+                keys = identity(event.to_dict())
+                if keys & seen:
+                    reasons["already known"] += 1
+                elif len(added) < capacity:
+                    seen.update(keys)
+                    added.append(event)
+                else:
+                    reasons["run limit reached"] += 1
+        print(f"Automatic discovery: {search.query_count} searches, {len(pages)} pages checked, "
+              f"{len(added)} newly verified; skipped: {dict(sorted(reasons.items()))}")
+    return verified + added, history + [event.to_dict() for event in added] if added else None
+
+
+def save(history: list[dict]) -> None:
+    tmp = REGISTRY.with_suffix(".json.tmp")
+    tmp.write_text(json.dumps({"events": history}, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
+    tmp.replace(REGISTRY)
