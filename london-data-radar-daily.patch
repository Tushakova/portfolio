@@ -0,0 +1,98 @@
+from dataclasses import replace
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import unittest
+from unittest.mock import patch
+
+from src.events import auto_discovery as auto
+from src.events import build
+from src.events.http import FetchError
+from src.events.models import Event
+from src.events.search import SearchSummary
+
+NOW = datetime(2026, 11, 21, 12, tzinfo=timezone.utc)
+URL = "https://www.eventbrite.co.uk/e/analytics-meetup-tickets-123"
+EVENT = Event("new", "Product Analytics Meetup", "2026-12-01T18:00:00+00:00",
+              "in_person", "Local organiser", "Web discovery", URL, venue_name="London Venue")
+
+
+def listing(**overrides):
+    return {
+        "@context": "https://schema.org", "@type": "Event", "url": URL,
+        "name": EVENT.title, "startDate": EVENT.start_at, "eventStatus": "https://schema.org/EventScheduled",
+        "location": {"@type": "Place", "name": EVENT.venue_name,
+                     "address": {"addressLocality": "London", "addressCountry": "GB"}},
+        "organizer": {"name": EVENT.organiser},
+        "offers": {"url": URL, "availability": "https://schema.org/InStock"},
+        **overrides,
+    }
+
+
+class AutomaticDiscoveryTest(unittest.TestCase):
+    def test_direct_listing_qualifies_and_skips_uncertain_evidence(self):
+        for changes, expected in [
+            ({}, True), ({"offers": {}}, False),
+            ({"description": "Invitation only"}, False),
+            ({"description": "This workshop is for employees only."}, False),
+            ({"startDate": "2026-12-01"}, False),
+            ({"startDate": "2026-11-21T11:30:00+00:00"}, False),
+            ({"eventStatus": "https://schema.org/EventCancelled"}, False),
+            ({"offers": {"url": URL.replace("123", "456"), "availability": "InStock"}}, False),
+            ({"location": {"@type": "Place", "name": "Venue",
+                           "address": {"addressLocality": "London", "addressCountry": "CA"}}}, False),
+        ]:
+            with self.subTest(changes=changes), patch("src.events.auto_discovery.fetch_html") as fetch:
+                fetch.return_value = f'<script type="application/ld+json">{json.dumps(listing(**changes))}</script>'
+                event, _ = auto.verify_page(URL, NOW)
+                self.assertEqual(event is not None, expected)
+                self.assertFalse(fetch.call_args.kwargs["allow_redirects"])
+        self.assertIsNone(auto.verify_page(URL.replace("www.eventbrite.co.uk", "example.org"), NOW)[0])
+        with patch("src.events.auto_discovery.fetch_html", side_effect=FetchError("redirect")):
+            self.assertIsNone(auto.verify_page(URL, NOW)[0])
+
+    def test_duplicates_are_excluded_from_active_archive_and_same_run(self):
+        crosspost = replace(EVENT, id="crosspost", source_url="https://luma.com/abcdef")
+        second = replace(EVENT, id="second", title="Experimentation meetup",
+                         source_url="https://www.eventbrite.co.uk/e/other-tickets-456")
+        lookup = {event.source_url: event for event in (EVENT, crosspost, second)}
+        for previous_section in ("events", "past_events"):
+            with self.subTest(previous_section=previous_section), TemporaryDirectory() as tmp, \
+                    patch.object(auto, "REGISTRY", Path(tmp) / "history.json"), \
+                    patch("src.events.search.discover", return_value=(set(lookup), SearchSummary(12, 3, 3))), \
+                    patch.object(auto, "verify_page", side_effect=lambda url, *_: (lookup[url], "verified")):
+                events, history = auto.collect([], {previous_section: [EVENT.to_dict()]}, NOW, discover_new=True)
+                self.assertEqual(events, [second])
+                self.assertEqual(history, [second.to_dict()])
+        self.assertTrue(auto.identity(EVENT.to_dict()) & auto.identity(replace(
+            EVENT, id="changed-id", title="Renamed", source_url=URL.replace("analytics-meetup", "new-name")
+        ).to_dict()))
+
+    def test_daily_rechecks_without_web_search_and_remembers_unavailable_event(self):
+        with TemporaryDirectory() as tmp, patch.object(auto, "REGISTRY", Path(tmp) / "history.json"), \
+                patch.object(auto, "verify_page", return_value=(None, "page unavailable")), \
+                patch("src.events.search.discover") as search:
+            auto.save([EVENT.to_dict()])
+            self.assertEqual(auto.collect([], {}, NOW, discover_new=False), ([], None))
+            search.assert_not_called()
+            self.assertEqual(json.loads(auto.REGISTRY.read_text())["events"], [EVENT.to_dict()])
+
+    def test_successful_build_publishes_and_second_run_does_not_add_again(self):
+        base = replace(EVENT, id="existing", title="Python London",
+                       source_url="https://example.org/python")
+        with TemporaryDirectory() as tmp:
+            data = Path(tmp)
+            output, status = data / "events.json", data / "status.json"
+            with patch.object(auto, "REGISTRY", data / "history.json"), \
+                    patch.object(build, "OUTPUT_PATH", output), patch.object(build, "CHECK_PATH", status), \
+                    patch.object(build, "datetime", wraps=datetime) as clock, \
+                    patch.object(build, "collect_events", return_value=([base], [])), \
+                    patch("src.events.search.discover", return_value=({URL}, SearchSummary(12, 1, 1))), \
+                    patch.object(auto, "fetch_html", return_value=f'<script type="application/ld+json">{json.dumps(listing())}</script>'):
+                clock.now.return_value = NOW
+                build.main(discover_new=True)
+                first = output.read_bytes()
+                self.assertEqual(json.loads(first)["event_count"], 2)
+                build.main(discover_new=True)
+                self.assertEqual(output.read_bytes(), first)
